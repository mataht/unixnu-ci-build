Place the non-monitor 4 KiB physical aperture below the static region so 14..16 GiB windows do not consume kernel_map VA.

sheng BootLog 20261114-03: raising /chosen/darwinboot-memory-size from 6 GiB to 8 GiB pushed static_memory_end up by
+2 GiB when physmap sat behind topOfKernelData, shrinking kernel_map sub-ranges to ~396 MiB (KERN_NO_SPACE e00002bd on
Adreno 740 16 MiB GMUCTX allocation). Moving [physmap_base, physmap_end) into the reserved TTBR1 space below
arm_vm_outside_va / gVirtBase leaves static_memory_end at phystokv(topOfKernelData) as on ARM_LARGE_MEMORY, freeing
~9.6 GiB of kernel_map VA while mapping the full 14 GiB CN window + 840 MiB adopted Bank 0.

--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2251,22 +2251,46 @@
 	static_memory_end = phystokv(args->topOfKernelData);
 	physmap_end = physmap_base + real_phys_size;
 #else
-	static_memory_end = physmap_base + mem_size + (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE); // worst possible case for block alignment
-	physmap_end = physmap_base + real_phys_size + (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE);
 	arm_vm_outside_init();
-	if (arm_vm_outside_end != 0) {
-		/*
-		 * The aperture's addresses for the memory outside the span: below the static region, 4 GiB and the
-		 * span's own length (to a whole L1 entry) under it, far above the low globals' alias at the bottom.
-		 */
+	{
 		const vm_map_address_t under = (gVirtBase & ~((vm_map_address_t)ARM_TT_L1_OFFMASK)) - ((vm_map_address_t)4 << 30);
-		const vm_map_size_t length = arm_vm_outside_end - arm_vm_outside_base;
 
-		arm_vm_outside_va = under - ROUND_L1(length);
-		arm_vm_outside_va_end = arm_vm_outside_va + length;
-		if (arm_vm_outside_va < VM_MIN_KERNEL_AND_KEXT_ADDRESS + ((vm_map_address_t)4 << 30) || arm_vm_outside_va >= under) {
-			panic("%s: no addresses below the static region for the memory outside the span", __func__);
+		if (arm_vm_outside_end != 0) {
+			/*
+			 * The aperture's addresses for the memory outside the span: below the static region, 4 GiB and the
+			 * span's own length (to a whole L1 entry) under it, far above the low globals' alias at the bottom.
+			 */
+			const vm_map_size_t length = arm_vm_outside_end - arm_vm_outside_base;
+
+			arm_vm_outside_va = under - ROUND_L1(length);
+			arm_vm_outside_va_end = arm_vm_outside_va + length;
+			if (arm_vm_outside_va < VM_MIN_KERNEL_AND_KEXT_ADDRESS + ((vm_map_address_t)4 << 30) || arm_vm_outside_va >= under) {
+				panic("%s: no addresses below the static region for the memory outside the span", __func__);
+			}
 		}
+
+		/*
+		 * Place the physical aperture below the static region (and below arm_vm_outside_va when present), in the
+		 * [VM_MIN_KERNEL_AND_KEXT_ADDRESS, LOW_GLOBAL_BASE_ADDRESS) range that pmap_virtual_region reserves out of
+		 * kernel_map. Keeping physmap behind topOfKernelData consumed mem_size of the ~3 GiB 4 KiB kernel_map VA
+		 * budget (causing KERN_NO_SPACE at >= 8 GiB on sheng); placing it below gVirtBase leaves static_memory_end
+		 * at topOfKernelData as on ARM_LARGE_MEMORY so a 14..16 GiB window fits alongside ~9.6 GiB of kernel_map VA.
+		 */
+		const vm_map_address_t physmap_ceiling = (arm_vm_outside_end != 0) ? arm_vm_outside_va : under;
+		const vm_map_size_t physmap_span = real_phys_size + (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE);
+		const unsigned long physmap_l1_entries =
+		    (unsigned long)((physmap_span + ARM64_PHYSMAP_SLIDE_RANGE + ARM_TT_L1_OFFMASK) >> ARM_TT_L1_SHIFT);
+		const vm_map_address_t physmap_region_base =
+		    physmap_ceiling - ((vm_map_address_t)physmap_l1_entries << ARM_TT_L1_SHIFT);
+
+		if (physmap_region_base < VM_MIN_KERNEL_AND_KEXT_ADDRESS + ((vm_map_address_t)4 << 30) ||
+		    physmap_region_base >= physmap_ceiling) {
+			panic("%s: no addresses below the static region for physical aperture (%lx)", __func__, mem_size);
+		}
+		physmap_base = physmap_region_base + physmap_slide;
+		physmap_end = physmap_base + physmap_span;
+		assert(ROUND_L1(physmap_end) <= physmap_ceiling);
+		static_memory_end = phystokv(args->topOfKernelData);
 	}
 #endif // ARM_LARGE_MEMORY
 #endif
