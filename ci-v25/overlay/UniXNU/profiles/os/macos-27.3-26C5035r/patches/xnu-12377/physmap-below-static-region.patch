+	 */
+	init_ptpages(cpu_tte, physmap_base & ~((vm_map_address_t)ARM_TT_L1_OFFMASK), ROUND_L1(physmap_end), TRUE,
+	    ARM_DYNAMIC_TABLE_XN | ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
 #endif
 
 
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2046,6 +2046,27 @@
 ml_static_takes_static_address(vm_offset_t vaddr, vm_size_t size)
 {
 	return ml_static_in_image_tail(vaddr, size) || arm_vm_static_segment_releasable(vaddr, size);
+}
+
+extern const vm_map_address_t physmap_end;
+extern vm_offset_t static_memory_end;
+
+/*
+ * Valid ranges for ml_static_protect / ml_static_mfree_prepare / ml_static_mfree when physmap_base may lie below
+ * gVirtBase: inside [physmap_base, physmap_end), an explicitly releasable static range (image tail or
+ * kc-segment-release segment), or dynamic early-boot KVA at/above static_memory_end (e.g. trailing vm_pages[] pages).
+ * Non-releasable KC segments in [gVirtBase, static_memory_end) and unmapped gaps below gVirtBase return false.
+ */
+static bool
+ml_static_address_valid(vm_offset_t vaddr, vm_size_t size)
+{
+	if (vaddr >= physmap_base && vaddr < physmap_end && size <= physmap_end - vaddr) {
+		return true;
+	}
+	if (vaddr >= static_memory_end && vaddr <= VM_MAX_KERNEL_ADDRESS && size <= VM_MAX_KERNEL_ADDRESS - vaddr) {
+		return true;
+	}
+	return ml_static_takes_static_address(vaddr, size);
 }
 
