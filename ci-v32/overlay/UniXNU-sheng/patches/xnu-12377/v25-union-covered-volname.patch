diff --git a/bsd/vfs/vfs_subr.c b/bsd/vfs/vfs_subr.c
index abbd26a..e0e80c3 100644
--- a/bsd/vfs/vfs_subr.c
+++ b/bsd/vfs/vfs_subr.c
@@ -13552,6 +13552,41 @@ native_union_identity(mount_t mp)
 	}
 	return mp;
 }
+
+mount_t
+native_union_covered_root(mount_t mp)
+{
+	mount_t top = rootvnode != NULLVP ? rootvnode->v_mount : NULL;
+	if (mp != NULL && mp == top && (top->mnt_flag & MNT_UNION) &&
+	    top->mnt_vnodecovered != NULLVP) {
+		mount_t covered = top->mnt_vnodecovered->v_mount;
+		if (covered != NULL && covered != top && (covered->mnt_flag & MNT_ROOTFS)) {
+			return covered;
+		}
+	}
+	return NULL;
+}
+
+bool
+native_union_covered_volname(mount_t mp, vfs_context_t ctx, char *buf, size_t len)
+{
+	mount_t covered = native_union_covered_root(mp);
+	if (covered == NULL || buf == NULL || len == 0) {
+		return false;
+	}
+	struct vfs_attr cvs;
+	VFSATTR_INIT(&cvs);
+	VFSATTR_WANTED(&cvs, f_vol_name);
+	cvs.f_vol_name = (char *)zalloc(ZV_NAMEI);
+	cvs.f_vol_name[0] = '\0';
+	bool ok = (vfs_getattr(covered, &cvs, ctx) == 0 &&
+	    VFSATTR_IS_SUPPORTED(&cvs, f_vol_name) && cvs.f_vol_name[0] != '\0');
+	if (ok) {
+		strlcpy(buf, cvs.f_vol_name, len);
+	}
+	zfree(ZV_NAMEI, cvs.f_vol_name);
+	return ok;
+}
 #endif /* XNU_TARGET_OS_OSX */
 
