 void __attribute__((noinline))
 PROC_CROSSED_HIGH_WATERMARK__SEND_EXC_RESOURCE_AND_SUSPEND(int max_footprint_mb, send_exec_resource_options_t exception_options)
 {
+	/*
+	 * ReportMemoryException / spindump / tailspind are disabled on this board;
+	 * cloning a 200+ MB task VM map into a Full corpse on non-fatal ActiveSoft /
+	 * InactiveSoft crossings only stalls the caller ~300 ms while memorystatus
+	 * already handles the soft limit directly.
+	 */
+	if ((exception_options & EXC_RESOURCE_FATAL) == 0) {
+		return;
+	}
